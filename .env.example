# PUBLIC: safe only for endpoint/project identifiers (no secrets)
# Do NOT reuse the live V1 Appwrite project. V2 needs an isolated project ID.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_LABEL=root-v2-dev-unprovisioned
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SERVER ONLY: never prefix API keys with NEXT_PUBLIC_
APPWRITE_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
APOLLO_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# OFF by default until integration/privacy signoff
APPWRITE_DATABASE_ID=
TURNSTILE_SECRET_KEY=
ROOT_ENABLE_AUTH=false
ROOT_ENABLE_CRM=false
ROOT_ENABLE_PAYMENTS=false
ROOT_ENABLE_PROSPECTING=false
ROOT_ENABLE_LIVE_CLAIMS=false
# Additive founder-activation placeholders (empty). See docs/engineering/integrations-activation.md
APPWRITE_SESSION_COOKIE_NAME=
HUBSPOT_PORTAL_ID=
STRIPE_PRICE_ID_DIAGNOSTIC=
STRIPE_CHECKOUT_SUCCESS_PATH=
STRIPE_CHECKOUT_CANCEL_PATH=
